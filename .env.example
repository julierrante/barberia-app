APP_NAME="Barbería Norte"
# URL pública de la app: se usa para armar el enlace de confirmación de asistencia
# que se envía por WhatsApp.
APP_BASE_URL="http://127.0.0.1:8000"
DATABASE_URL="sqlite:///./barberia.db"
BUSINESS_TIMEZONE="America/Argentina/Buenos_Aires"

# Panel interno. Cambiar antes de publicar la app.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esta-clave"
SESSION_SECRET="generar-una-clave-larga-y-aleatoria"

# Reglas de agenda
MIN_NOTICE_MINUTES=30
SLOT_GRANULARITY_MINUTES=15
BOOKING_DAYS_AHEAD=45

# "mock" simula el cobro. Nunca se ingresan datos de tarjeta en esta versión.
PAYMENTS_MODE="mock"

# Recordatorios por WhatsApp: 90 y 60 minutos antes del turno.
# "mock" registra los envíos sin salir a internet. Para enviar de verdad,
# configurá "cloud" con las credenciales de Meta WhatsApp Cloud API.
WHATSAPP_MODE="mock"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Plantilla aprobada por Meta con 6 parámetros en este orden:
# nombre, servicio, barbero, fecha (DD/MM/AAAA), hora (HH:MM) y enlace de
# confirmación de asistencia.
WHATSAPP_TEMPLATE_NAME="recordatorio_turno"
WHATSAPP_TEMPLATE_LANGUAGE="es_AR"
WHATSAPP_API_VERSION="v21.0"
REMINDER_WORKER_ENABLED=true
REMINDER_WORKER_INTERVAL_SECONDS=30
# Ante un turno sin confirmación del cliente: minutos antes del inicio a los
# que se envía el último aviso por WhatsApp y se marca el turno como "por
# vencer" en la agenda de la dueña y los barberos.
CONFIRMATION_DEADLINE_MINUTES=45

# Cierre diario de ganancias por barbero. Se guarda un registro por barbero
# (incluso con cero movimiento) a la hora configurada, en la zona horaria del negocio.
DAILY_CLOSE_ENABLED=true
DAILY_CLOSE_HOUR=23
DAILY_CLOSE_MINUTE=30
CLOSING_WORKER_INTERVAL_SECONDS=60

# Configuración SaaS
# Dominio base donde se alojarán las barberías.
SAAS_BASE_DOMAIN="tuapp.com"

# Barbería utilizada en desarrollo local.
SAAS_LOCAL_BARBERIA_SLUG="barberia-norte"